
# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here  # Replace with your actual API key

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000


# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/  # Replace with your MongoDB connection string
MONGODB_DATABASE=eco_products  # Replace with your database name

